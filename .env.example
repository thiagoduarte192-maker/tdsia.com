# Variaveis de ambiente do tds-site
# Copie para .env.local (desenvolvimento) ou .env.production.local (produção no VPS)

# Senha para acessar a área administrativa (/admin)
ADMIN_PASSWORD=trocar-esta-senha

# Chave secreta para assinar os cookies de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=trocar-este-secret

# String de conexão PostgreSQL (formato: postgresql://user:pass@host:port/db)
# Em dev local, usa SSH tunnel: ssh -L 5433:127.0.0.1:5432 root@VPS
DATABASE_URL=postgresql://tdsia_admin:trocar-esta-senha@localhost:5433/tdsia
